# Copy to keystore.properties (git-ignored) for signed release builds: ./gradlew bundleRelease
# Create an upload key once with:
#   keytool -genkeypair -v -keystore upload.keystore -alias upload -keyalg RSA -keysize 2048 -validity 10000
# and keep the keystore and passwords somewhere safe (a password manager), never in git.
storeFile=upload.keystore
storePassword=CHANGE_ME
keyAlias=upload
keyPassword=CHANGE_ME
